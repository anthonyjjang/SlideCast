# 서버
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-secret-key-here

# 데이터베이스
DATABASE_URL=postgresql+asyncpg://slidenarrator:password@localhost:5432/slidenarrator

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS S3 (옵션)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=slidenarrator-outputs

# TTS
TTS_DEFAULT_ENGINE=edge

# 제한 설정
MAX_FILE_SIZE_MB=100
MAX_SLIDES=100
